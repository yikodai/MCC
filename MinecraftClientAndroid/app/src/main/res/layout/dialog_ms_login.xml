<?xml version="1.0" encoding="utf-8"?>
<!-- 微软登录对话框：展示设备码与验证网址，等待用户完成授权 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="8dp"
    android:paddingEnd="24dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/msLoginInstruction"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/ms_login_instruction"
        android:textAppearance="?attr/textAppearanceBodyMedium" />

    <!-- 设备码：大号、可长按选中复制 -->
    <TextView
        android:id="@+id/msUserCode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="monospace"
        android:gravity="center"
        android:letterSpacing="0.15"
        android:textColor="?attr/colorPrimary"
        android:textIsSelectable="true"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/msVerificationUri"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:textColor="?attr/colorPrimary"
        android:textIsSelectable="true"
        android:textAppearance="?attr/textAppearanceBodyLarge" />

    <TextView
        android:id="@+id/msLoginStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:alpha="0.7"
        android:text="@string/ms_login_waiting"
        android:textAppearance="?attr/textAppearanceBodySmall" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/openBrowserButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/ms_login_open_browser" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/copyCodeButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/ms_login_copy_code" />
    </LinearLayout>

</LinearLayout>